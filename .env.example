# Copy this file to ".env" (same folder as package.json) and fill it in. ".env" is never committed or zipped by git (see .gitignore).

# --- PUBLIC values: these two go inside the app. They are safe there; the database rules keep each family's data private.
#     Supabase → Project Settings → API
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-publishable-key-here

# --- PRIVATE values: for your own computer only. The app NEVER reads these (the database setup, `npm run db:setup`, reads the connection string).
#     Do not give them an EXPO_PUBLIC_ name: Expo copies EXPO_PUBLIC_ values into the app.
#     The connection string is Supabase → Connect → "Session pooler". Every line here must be NAME=VALUE (no bare passwords on their own line).
# SUPABASE_SECRET_KEY=
# SUPABASE_DB_CONNECTION_STRING=
