{
  "name": "4d-ages",
  "version": "1.0.3",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "setup": "expo install expo-router react-native-screens react-native-safe-area-context expo-linking expo-constants expo-status-bar expo-image-picker expo-file-system expo-image expo-video expo-print expo-sharing expo-font expo-splash-screen expo-notifications react-native-pager-view @react-navigation/material-top-tabs react-native-tab-view @expo/vector-icons expo-dev-client @react-native-async-storage/async-storage @react-native-community/datetimepicker @react-native-community/slider expo-system-ui react-dom react-native-reanimated react-native-worklets typescript @types/react && expo install --fix",
    "start": "expo start --dev-client",
    "android": "expo run:android --device",
    "prebuild": "expo prebuild --platform android",
    "doctor": "npx --yes expo-doctor",
    "typecheck": "tsc --noEmit",
    "test": "node tests/run.mjs",
    "android:sync": "expo prebuild --platform android --clean",
    "brand:assets": "python3 branding/make-assets.py",
    "db:setup": "node scripts/setup-database.mjs",
    "signing:key": "node scripts/make-release-keystore.mjs",
    "release:bump": "node scripts/bump-version.mjs",
    "check": "node scripts/check-setup.mjs",
    "prestart": "node scripts/check-setup.mjs",
    "preandroid": "node scripts/check-setup.mjs",
    "preandroid:sync": "node scripts/check-setup.mjs"
  },
  "dependencies": {
    "@expo-google-fonts/fraunces": "^0.4.1",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.1.0",
    "@react-native-community/slider": "5.2.0",
    "@react-native-google-signin/google-signin": "^16.1.5",
    "@react-navigation/material-top-tabs": "^7.8.0",
    "@supabase/supabase-js": "^2.45.0",
    "@types/react": "~19.2.4",
    "expo": "~57.0.26",
    "expo-constants": "~57.0.21",
    "expo-dev-client": "~57.0.19",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-image": "~57.0.5",
    "expo-image-manipulator": "~57.0.21",
    "expo-image-picker": "~57.0.20",
    "expo-linking": "~57.0.12",
    "expo-notifications": "~57.0.22",
    "expo-print": "~57.0.2",
    "expo-router": "~57.0.25",
    "expo-sharing": "~57.0.22",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
