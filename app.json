{
  "expo": {
    "name": "4D Ages",
    "slug": "4d-ages",
    "scheme": "fourdages",
    "version": "1.1.3",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "android": {
      "package": "com.alonc.fourdages",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FEFBF6",
        "monochromeImage": "./assets/adaptive-icon-monochrome.png"
      },
      "blockedPermissions": [
        "android.permission.CAMERA"
      ],
      "intentFilters": [
        {
          "action": "SEND",
          "category": [
            "DEFAULT"
          ],
          "data": [
            {
              "mimeType": "image/*"
            },
            {
              "mimeType": "video/*"
            },
            {
              "mimeType": "audio/*"
            },
            {
              "mimeType": "application/ogg"
            }
          ]
        },
        {
          "action": "SEND_MULTIPLE",
          "category": [
            "DEFAULT"
          ],
          "data": [
            {
              "mimeType": "image/*"
            },
            {
              "mimeType": "video/*"
            },
            {
              "mimeType": "audio/*"
            },
            {
              "mimeType": "application/ogg"
            }
          ]
        }
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 288,
          "resizeMode": "contain",
          "backgroundColor": "#FEFBF6"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "4D Ages lets you choose photos and videos for your baby book."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#974164"
        }
      ],
      "./plugins/withKeepScreenAlive",
      [
        "expo-audio",
        {
          "microphonePermission": "Allow 4D Ages to record voice notes for your child's book."
        }
      ],
      [
        "expo-calendar",
        {
          "calendarPermission": "4D Ages adds your pet's vet, vaccine and treatment reminders to your calendar, when you ask it to."
        }
      ]
    ],
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/icon.png",
      "name": "4D Ages",
      "shortName": "4D Ages",
      "description": "Keepsake books for the ages: your child's photos, milestones and stories, made into books and videos.",
      "themeColor": "#E8798F",
      "backgroundColor": "#FEFBF6",
      "lang": "en"
    }
  }
}
