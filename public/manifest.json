{
  "name": "4D Ages",
  "short_name": "4D Ages",
  "description": "Keepsake books for the ages: your child's photos, milestones and stories, made into books and videos.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#FEFBF6",
  "theme_color": "#E8798F",
  "icons": [
    { "src": "/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "share_target": {
    "action": "/share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "files": [{ "name": "media", "accept": ["image/*", "video/*", "audio/*", ".opus", ".ogg", ".m4a", ".mp3"] }]
    }
  }
}
